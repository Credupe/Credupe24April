{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credupe-prod-api",
  "routes": [
    {
      "pattern": "api.credupe.com/*",
      "zone_name": "credupe.com"
    }
  ],
  "main": "src/index.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "credupe",
      "database_id": "268e6760-85d8-4f50-9ea6-5c1fd9d28de9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "credupe-docs"
    }
  ],
  "vars": {
    "API_PREFIX": "/api/v1",
    "JWT_ACCESS_TTL": "900",
    "JWT_REFRESH_TTL": "2592000",
    "BCRYPT_SALT_ROUNDS": "10",
    "CORS_ORIGINS": "*",
    "NOTIFICATION_EMAIL": "av457508@gmail.com,mahesh@credupe.com,Aniket@credupe.com,Contact@credupe.com",
    "DAILY_LEADS_REPORT_TIME": "12:00",
    "DAILY_LEADS_REPORT_TIMEZONE": "Asia/Kolkata",
    "TELNYX_SENDER": "+14244797457",
    "TWILIO_SENDER": "+17627612607"
  },
  "env": {
    "staging": {
      "name": "credupe-staging-api",
      "routes": [
        {
          "pattern": "staging-api.credupe.com/*",
          "zone_name": "credupe.com"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "credupe-db-staging",
          "database_id": "e87a3726-0767-4271-bd5c-1be07f0c0fde",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCS",
          "bucket_name": "credupe-docs-staging"
        }
      ],
      "vars": {
        "API_PREFIX": "/api/v1",
        "JWT_ACCESS_TTL": "900",
        "JWT_REFRESH_TTL": "2592000",
        "RESEND_FROM_EMAIL": "Credupe Staging <noreply+staging@credupe.com>",
        "BCRYPT_SALT_ROUNDS": "10",
        "CORS_ORIGINS": "https://staging.credupe.com,https://credupe-staging-web.credupe.workers.dev",
        "NOTIFICATION_EMAIL": "av457508@gmail.com,mahesh@credupe.com,Aniket@credupe.com,Contact@credupe.com",
        "DAILY_LEADS_REPORT_TIME": "12:00",
        "DAILY_LEADS_REPORT_TIMEZONE": "Asia/Kolkata",
        "TELNYX_SENDER": "+14244797457",
        "TWILIO_SENDER": "+17627612607"
      }
    },
    "production": {
      "name": "credupe-prod-api",
      "routes": [
        {
          "pattern": "api.credupe.com/*",
          "zone_name": "credupe.com"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "credupe",
          "database_id": "268e6760-85d8-4f50-9ea6-5c1fd9d28de9",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCS",
          "bucket_name": "credupe-docs"
        }
      ],
      "vars": {
        "API_PREFIX": "/api/v1",
        "JWT_ACCESS_TTL": "900",
        "JWT_REFRESH_TTL": "2592000",
        "RESEND_FROM_EMAIL": "Credupe <noreply@credupe.com>",
        "BCRYPT_SALT_ROUNDS": "10",
        "CORS_ORIGINS": "https://credupe.com,https://www.credupe.com,https://credupe-prod-web.credupe.workers.dev",
        "NOTIFICATION_EMAIL": "av457508@gmail.com,mahesh@credupe.com,Aniket@credupe.com,Contact@credupe.com",
        "DAILY_LEADS_REPORT_TIME": "12:00",
        "DAILY_LEADS_REPORT_TIMEZONE": "Asia/Kolkata",
        "TELNYX_SENDER": "+14244797457",
        "TWILIO_SENDER": "+17627612607"
      }
    }
  }
}