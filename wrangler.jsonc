{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credupe-prod-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "credupe-prod-web"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    { "pattern": "credupe.com", "custom_domain": true },
    { "pattern": "www.credupe.com", "custom_domain": true },
    { "pattern": "*.credupe.com/*", "zone_name": "credupe.com" }
  ],
  "env": {
    "staging": {
      "name": "credupe-staging-web",
      "routes": [
        { "pattern": "staging.credupe.com/*", "zone_name": "credupe.com" }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "credupe-staging-web"
        }
      ]
    }
  }
}